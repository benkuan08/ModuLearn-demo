# A provider serving this EXACT checkpoint. Never commit .env or a real token.
LLM_PROVIDER=openai
LLM_MODEL=google/gemma-4-E2B-it
# Supply an endpoint whose catalog actually lists your chosen model.
# The Hugging Face repository is a download page, not a hosted API.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=90
# Enable only if your provider supports JSON-object response mode.
LLM_COMPACT_CONTEXT=true
# Optional local directory caching model-specific planning summaries.
LLM_DIGEST_CACHE_DIR=
LLM_JSON_MODE=false
# Optional provider-specific generation settings, as one JSON object.
LLM_EXTRA_BODY={}
HOST=0.0.0.0
PORT=3000

# Alternative hosted Qwen configuration (do not combine tokens/endpoints):
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_MODEL=Qwen/Qwen3.5-9B
# HF_TOKEN=your_token_with_inference_provider_permission
